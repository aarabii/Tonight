{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@tonight/shared": ["../../packages/shared/src/index.ts"],
      "@supabase/supabase-js": ["../../pipeline/node_modules/@supabase/supabase-js"]
    }
  },
  "include": ["**/*.ts", "_shared/deno.d.ts"]
}
