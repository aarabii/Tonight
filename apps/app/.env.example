# Supabase public project URL & anon/publishable key (RLS protects all user tables)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry public DSN (optional in local dev)
EXPO_PUBLIC_SENTRY_DSN=

# Default ISO-3166-1 alpha-2 region for streaming providers
EXPO_PUBLIC_DEFAULT_REGION=IN
